# Sentiment Options Lab - Configuration
# Copy to .env and customize

# ── Application Mode ─────────────────────────────────────────────────
# "signal" = alert-only dashboard (default), "trade" = paper trading
APP_MODE=signal

# Timezone
TIMEZONE=America/New_York

# RSS Feeds (comma-separated)
RSS_FEEDS=https://feeds.finance.yahoo.com/rss/2.0/headline?s=AAPL,TSLA,NVDA,MSFT,AMZN,GOOGL,META&region=US&lang=en-US,https://feeds.finance.yahoo.com/rss/2.0/headline?region=US&lang=en-US,https://www.investing.com/rss/news_301.rss,https://seekingalpha.com/market_currents.xml

# Watchlist JSON: ticker -> [aliases]
WATCHLIST_JSON={"AAPL": ["Apple", "AAPL", "iPhone", "iPad", "Mac", "Tim Cook"], "TSLA": ["Tesla", "TSLA", "Elon Musk", "EV maker Tesla", "Cybertruck"], "NVDA": ["Nvidia", "NVDA", "Jensen Huang", "GeForce", "CUDA"], "MSFT": ["Microsoft", "MSFT", "Satya Nadella", "Azure", "Windows", "Xbox"], "AMZN": ["Amazon", "AMZN", "AWS", "Jeff Bezos", "Andy Jassy", "Prime"], "GOOGL": ["Google", "Alphabet", "GOOGL", "Sundar Pichai", "YouTube", "Waymo"], "META": ["Meta", "META", "Facebook", "Mark Zuckerberg", "Instagram", "WhatsApp", "Threads"], "AMD": ["AMD", "Advanced Micro Devices", "Lisa Su", "Radeon", "Ryzen"], "NFLX": ["Netflix", "NFLX"], "JPM": ["JPMorgan", "JPM", "Jamie Dimon"]}

# ── Polling Intervals ────────────────────────────────────────────────
NEWS_POLL_SECONDS=180
OPTIONS_REFRESH_MINUTES=30
DECISION_TICK_MINUTES=30

# ── Social Sources ───────────────────────────────────────────────────
SOCIAL_ENABLED=true
REDDIT_SUBREDDITS=wallstreetbets,stocks,options,investing
REDDIT_POLL_SECONDS=45
STOCKTWITS_POLL_SECONDS=60

# ── Source Tier / Cross-Tier ─────────────────────────────────────────
# Require signals from both tier-1 (Reuters, Yahoo, SEC) AND tier-2 (Reddit, StockTwits)
REQUIRE_CROSS_TIER=false

# ── Flow Detection ───────────────────────────────────────────────────
FLOW_VOLUME_SPIKE_MULTIPLIER=3.0
FLOW_OI_SPIKE_MULTIPLIER=2.0

# ── Trigger-based Fetch ──────────────────────────────────────────────
TRIGGER_FETCH_COOLDOWN_SECONDS=300

# ── Market Hours (ET) ────────────────────────────────────────────────
LAST_ENTRY_TIME_ET=15:00
MARKET_OPEN_ET=09:30
MARKET_CLOSE_ET=16:00

# ── Candidate Thresholds ─────────────────────────────────────────────
MIN_SENTIMENT_MAG=0.65
MIN_CONFIDENCE=0.75
MIN_COVERAGE_SCORE=3
MIN_DISTINCT_SOURCES=2
MAX_CANDIDATES_PER_CYCLE=5
CANDIDATE_COOLDOWN_MINUTES=60

# ── Trade Limits (trade mode only) ───────────────────────────────────
MAX_NEW_TRADES_PER_TICK=3
MAX_OPEN_POSITIONS=6
PER_TICKER_MAX_POSITIONS=1

# ── Options Selection ────────────────────────────────────────────────
DELTA_TARGET_MIN=0.45
DELTA_TARGET_MAX=0.65
STRIKE_WINDOW=10
EXPIRY_NEAR_DTE_MIN=7
EXPIRY_NEAR_DTE_MAX=14
EXPIRY_MID_DTE_MIN=30
EXPIRY_MID_DTE_MAX=45

# ── Risk / Paper Trading ─────────────────────────────────────────────
PROFIT_TARGET_PCT=0.30
STOP_LOSS_PCT=0.25
TIME_STOP_HOURS=6
STARTING_CASH=100000
RISK_PER_TRADE_PCT=0.01
SLIPPAGE_PCT=0.005

# ── Database ─────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./sentiment_options_lab.db

# ── Backend ──────────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ── Frontend ─────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
